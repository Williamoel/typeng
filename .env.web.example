TYPENG_WEB_MODE=1
TYPENG_SECRET_KEY=replace-with-at-least-32-random-bytes
TYPENG_ALLOWED_HOSTS=typeng.example.com
TYPENG_COOKIE_SECURE=1
# Optional when the compact cache is mounted outside the image:
# TYPENG_LEXICON_PATH=/opt/typeng/typeng-lexicon.sqlite3
# TYPENG_LEXICON_URL=https://github.com/Williamoel/typeng/releases/latest/download/typeng-lexicon.sqlite3
